# Copiar a .env.local (local) o cargar en el hosting (Vercel → Settings → Environment Variables)
NEXT_PUBLIC_SITE_URL=https://www.megafardosdelnorte.com.ar
# Google Analytics 4 → Administrar → Flujos de datos → ID de medición
NEXT_PUBLIC_GA_ID=G-YC9PF5HL3V
# Google Search Console → método "Etiqueta HTML" → solo el valor de content="..."
NEXT_PUBLIC_GSC_VERIFICATION=

# ---- Storyblok (CMS). Sin STORYBLOK_TOKEN el sitio usa el contenido de src/content/defaults.ts
# Access token "Preview" del espacio (Settings → Access Tokens). Solo servidor: nunca NEXT_PUBLIC_.
STORYBLOK_TOKEN=
# Región del espacio: eu | us | ca | ap
STORYBLOK_REGION=eu
# Clave para abrir el sitio en modo borrador desde el Visual Editor (cualquier texto largo al azar)
STORYBLOK_PREVIEW_SECRET=
# Clave del webhook que actualiza el sitio al publicar (la misma que se pone en Storyblok → Webhooks)
STORYBLOK_WEBHOOK_SECRET=

# Solo para `npm run storyblok:setup` (no cargar en Vercel)
STORYBLOK_OAUTH_TOKEN=
STORYBLOK_SPACE_ID=
